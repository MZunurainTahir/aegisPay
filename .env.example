# ── PayPal Sandbox ───────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_SECRET=your_paypal_sandbox_secret

# ── LLM Provider (pick one or both) ─────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
# LLM_PROVIDER=openai   # or "anthropic"  (defaults to openai if key present)

# ── Gateway ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///aegis.db    # or postgres://user:pass@host/db
GATEWAY_URL=http://localhost:8000  # used by agent + dashboard locally
CORS_ORIGINS=http://localhost:3000 # comma-separated dashboard origin(s)

# ── Dashboard ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

